{
  "installCommand": "cd expo-app && npm install --legacy-peer-deps",
  "buildCommand": "cd expo-app && npx expo export -p web",
  "outputDirectory": "expo-app/dist",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}

